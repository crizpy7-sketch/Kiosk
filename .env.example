# ─── Wild Frame AI — environment ────────────────────────────────────────────
# Copy to .env.local for development. Every value here is server-only; nothing in
# this file is prefixed NEXT_PUBLIC_, so nothing here reaches the browser bundle.
# src/lib/env.ts validates all of it at boot and refuses to start on a bad config.

# ─── Core ───────────────────────────────────────────────────────────────────
NODE_ENV=development
APP_BASE_URL=http://localhost:3000

# 32+ random bytes. Signs admin session cookies and demo webhooks.
#   openssl rand -base64 48
APP_SECRET=replace-me-with-at-least-32-random-characters-please

# ─── Demo mode ──────────────────────────────────────────────────────────────
# true  → payment and AI are simulated locally. No Stripe charge, no Decart credits.
# Refused when NODE_ENV=production unless ALLOW_DEMO_MODE_IN_PRODUCTION=true.
DEMO_MODE=true
ALLOW_DEMO_MODE_IN_PRODUCTION=false

# ─── Database (PostgreSQL 14+; Supabase works unchanged) ────────────────────
DATABASE_URL=postgresql://postgres@localhost:5432/wildframe_dev

# ─── Supabase (only when STORAGE_DRIVER=supabase) ───────────────────────────
# SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# ─── Stripe (required when DEMO_MODE=false) ─────────────────────────────────
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# ─── Decart (required when DEMO_MODE=false) ─────────────────────────────────
# The permanent key. Read only by the server; short-lived scoped client tokens
# are minted from it per session. This value must never reach the browser.
# DECART_API_KEY=

# ─── Storage ────────────────────────────────────────────────────────────────
STORAGE_DRIVER=filesystem
STORAGE_BUCKET=wildframe-private
STORAGE_LOCAL_DIR=.data/assets

# ─── Kiosk behaviour ────────────────────────────────────────────────────────
KIOSK_ID=kiosk-shia-baby-01
DEFAULT_LANGUAGE=en
DOWNLOAD_LINK_TTL_HOURS=24
SESSION_MAX_SECONDS=15
COUNTDOWN_SECONDS=3
ATTRACT_TIMEOUT_SECONDS=90

# ─── Seeding (scripts/seed.ts only) ─────────────────────────────────────────
SEED_OWNER_EMAIL=owner@wildframe.local
# Omit to have a strong password generated and printed once.
# SEED_OWNER_PASSWORD=

# ─── Optional ───────────────────────────────────────────────────────────────
# Extra hosts appended to the CSP connect-src (regional/self-hosted Decart).
# CSP_EXTRA_CONNECT_SRC=
